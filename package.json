{
  "name": "selfie-design-system",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "tokens:build": "pnpm --filter @selfie-ds/tokens build",
    "tokens:figma": "pnpm --filter @selfie-ds/tokens figma",
    "storybook": "pnpm tokens:build && pnpm --filter storybook dev",
    "storybook:build": "pnpm tokens:build && pnpm --filter storybook build",
    "lint": "pnpm lint:css && pnpm --filter @selfie-ds/react typecheck",
    "lint:css": "stylelint \"packages/*/src/**/*.css\"",
    "test": "pnpm --filter @selfie-ds/react test"
  },
  "devDependencies": {
    "stylelint": "16.10.0"
  }
}
